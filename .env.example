# ── Signaling (Node.js) ──────────────────────────────────────────
SIGNALING_PORT=8080
ORCHESTRATOR_WS_URL=ws://orchestrator:8090/v1/media
JWT_SECRET=change-me-in-production
DATABASE_URL=postgres://translate:translate@127.0.0.1:5432/translate
OTP_TTL_SEC=300

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Apple VoIP Push (CallKit incoming)
APNS_KEY_PATH=./certs/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.translatelanguage.app
APNS_PRODUCTION=false

# Android FCM HTTP v1
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Orchestrator (Python) ────────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8090
PIPELINE_PROVIDER=mock            # google | azure | sarvam | mock
STT_PROVIDER=                     # google_v2 | azure | sarvam | mock  (override)
TRANSLATOR_PROVIDER=              # google | azure | sarvam | openai | anthropic
TTS_PROVIDER=                     # google | azure | sarvam | mock
SAMPLE_RATE_HZ=16000
FRAME_MS=20
TARGET_E2E_MS=1000

# Google Cloud Speech-to-Text V2 + Translate + TTS
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-credentials.json
GOOGLE_PROJECT_ID=
GOOGLE_STT_MODEL=latest_short
GOOGLE_STT_LOCATION=global
GOOGLE_TTS_AUDIO_ENCODING=LINEAR16

# Azure Speech + Translator
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Sarvam AI (Saaras STT, Mayura MT, Bulbul TTS)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka
SARVAM_BASE_URL=https://api.sarvam.ai

# LLM translators
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Latency / VAD
VAD_BACKEND=silero                # silero | webrtc
VAD_THRESHOLD=0.45
VAD_SILENCE_MS=180                # endpointing: flush after this silence
VAD_MIN_SPEECH_MS=120
VAD_MAX_UTTERANCE_MS=1800
VAD_AGGRESSIVENESS=2              # webrtcvad fallback only
PARTIAL_TRANSLATE=true
PARTIAL_MIN_CHARS=4
HALF_DUPLEX=true
BARGE_IN=true
